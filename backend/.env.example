DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agenthub-artifacts
CORS_ORIGINS=["http://localhost:5173"]

# ========== ADK Streaming ==========
AGENTHUB_USE_ADK_STREAM=false
AGENTHUB_MODEL_PROVIDER=anthropic
AGENTHUB_MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...  # fill in your key
ANTHROPIC_BASE_URL=           # optional custom base URL
OPENAI_API_KEY=               # required for LiteLLM/openai agents

# ========== CLI Tool Paths ==========
CLAUDE_CODE_CLI_PATH=claude               # path or command name
CODEX_CLI_PATH=codex                      # path or command name
CLAUDE_CODE_TIMEOUT_SECONDS=300
CLAUDE_CODE_MAX_BUDGET_USD=5.0
CODEX_CLI_TIMEOUT_SECONDS=300
CODEX_CLI_MODEL=deepseek-v4-pro
CLI_DEFAULT_WORKSPACE=.                   # default project directory

# ========== Auth ==========
AUTH_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== Email ==========
EMAIL_API_KEY=
EMAIL_FROM=AgentHub <noreply@agenthub.example.com>
